# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Template for required environment variables
# Copy this to .env and fill in your values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# AWS Credentials (for local development only)
# In production (EKS), the scaler uses IRSA — no static credentials needed.
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# S3 bucket name where trained model artifacts are stored
# Created by Terraform in Phase 4
S3_BUCKET=hpa-scaler-model-artifacts

# Set to "true" to load model from local ./ml/artifacts/ instead of S3
DEV_MODE=false

# Local model path (used when DEV_MODE=true)
MODEL_PATH=/app/artifacts/model.pkl
